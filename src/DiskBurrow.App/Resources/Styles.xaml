<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:s="clr-namespace:DiskBurrow.App.Services">
  <SolidColorBrush x:Key="Ink" Color="#172A3A"/><SolidColorBrush x:Key="Accent" Color="#265D9F"/>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/><s:ByteConverter x:Key="Bytes"/><s:LocalizedValueConverter x:Key="LocalValue"/><s:AllTrueConverter x:Key="AllTrue"/>
  <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="#EEF2F6"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinHeight" Value="34"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="6,4"/><Setter Property="MinHeight" Value="28"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="5,4"/><Setter Property="MinHeight" Value="28"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Title" TargetType="TextBlock"><Setter Property="FontSize" Value="22"/><Setter Property="Margin" Value="0,0,0,18"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontSize" Value="17"/><Setter Property="Margin" Value="0,16,0,8"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Note" TargetType="TextBlock"><Setter Property="Foreground" Value="#465B6C"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,8,0,10"/></Style>
  <Style x:Key="Value" TargetType="TextBlock"><Setter Property="FontSize" Value="22"/><Setter Property="Margin" Value="0,4,12,12"/></Style>
  <Style x:Key="PathText" TargetType="TextBox"><Setter Property="IsReadOnly" Value="True"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalScrollBarVisibility" Value="Auto"/><Setter Property="TextWrapping" Value="NoWrap"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/><Setter Property="RowHeight" Value="32"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E1E7EE"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CED8E2"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="8"/><Setter Property="Background" Value="#EEF2F6"/><Setter Property="Foreground" Value="#465B6C"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="12,14"/><Setter Property="MinWidth" Value="184"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style>
</ResourceDictionary>
