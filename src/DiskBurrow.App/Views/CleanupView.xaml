<UserControl x:Class="DiskBurrow.App.Views.CleanupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{DynamicResource Nav.Cleanup}" Style="{StaticResource Title}"/><StackPanel Grid.Row="1"><TextBlock Text="{DynamicResource Cleanup.Warning}" Foreground="#A73436" Margin="0,0,0,8"/><TextBlock Text="{DynamicResource Cleanup.Scope}" TextWrapping="Wrap" Style="{StaticResource Note}"/><ItemsControl ItemsSource="{Binding CleanupCategorySummaries}" Margin="0,0,0,10"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#CED8E2" BorderThickness="1" Padding="10,6" Margin="0,0,8,6" Width="245"><StackPanel><TextBlock Text="{Binding Category}" FontWeight="SemiBold"/><TextBlock Text="{Binding Size}"/><TextBlock Text="{Binding Status}" FontSize="12"/><TextBlock Text="{Binding Warnings}" FontSize="12" Foreground="#9B6500"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
    <DockPanel Grid.Row="2" Margin="0,0,0,8"><Button Tag="Analyze" Content="{DynamicResource Action.Analyze}" IsEnabled="{Binding Idle}"/><TextBlock Text="{DynamicResource Filter}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Text="{Binding Filter,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Idle}"/></DockPanel>
    <DockPanel Grid.Row="3" Margin="0,0,0,8"><ComboBox ItemsSource="{Binding Cleanup.Categories}" SelectedItem="{Binding Category}" Width="155" IsEnabled="{Binding Idle}"><ComboBox.ItemTemplate><DataTemplate><TextBlock><TextBlock.Text><MultiBinding Converter="{StaticResource LocalValue}"><Binding/><Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></TextBlock.Text></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Tag="ExcludeCategory" Content="{DynamicResource Action.ExcludeCategory}" IsEnabled="{Binding Idle}" Margin="8,0,8,0"/><Button Tag="ExcludeFile" Content="{DynamicResource Action.ExcludeFile}" IsEnabled="{Binding Idle}"/></DockPanel>
    <DataGrid Grid.Row="4" Tag="Candidates" ItemsSource="{Binding CleanupRows}" IsEnabled="{Binding Idle}"><DataGrid.Columns><DataGridTemplateColumn Width="80"><DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Select}" TextWrapping="NoWrap"/></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Binding="{Binding Path}" Width="*" MinWidth="200"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Path}" TextWrapping="NoWrap"/></DataGridTextColumn.Header></DataGridTextColumn><DataGridTextColumn Binding="{Binding Category}" Width="140"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Category}" TextWrapping="NoWrap"/></DataGridTextColumn.Header></DataGridTextColumn><DataGridTextColumn Binding="{Binding Bytes,Converter={StaticResource Bytes}}" Width="95"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Logical}" TextWrapping="NoWrap"/></DataGridTextColumn.Header></DataGridTextColumn><DataGridTextColumn Binding="{Binding Modified}" Width="160"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Modified}" TextWrapping="NoWrap"/></DataGridTextColumn.Header></DataGridTextColumn><DataGridTextColumn Binding="{Binding Reason}" Width="210"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Reason}" TextWrapping="NoWrap"/></DataGridTextColumn.Header></DataGridTextColumn></DataGrid.Columns></DataGrid>
    <StackPanel Grid.Row="5"><TextBlock Text="{DynamicResource Cleanup.Bound}" Style="{StaticResource Note}"/><TextBlock Text="{Binding SelectedSummary}" FontWeight="SemiBold"/><Button HorizontalAlignment="Left" Margin="0,10,0,8" Tag="Delete" Content="{DynamicResource Action.Delete}" Foreground="#A73436"><Button.IsEnabled><MultiBinding Converter="{StaticResource AllTrue}"><Binding Path="Idle"/><Binding Path="Cleanup.CanExecuteCleanup"/></MultiBinding></Button.IsEnabled></Button><TextBlock><Run Text="{DynamicResource Cleanup.FreeDelta}"/><Run Text=" : "/><Run Text="{Binding FreeDelta,Mode=OneWay}"/></TextBlock><TextBlock><Run Text="{DynamicResource Cleanup.Unattempted}"/><Run Text=" : "/><Run Text="{Binding Cleanup.UnattemptedCount,Mode=OneWay}"/></TextBlock></StackPanel>
    <Expander Grid.Row="6" Header="{DynamicResource Cleanup.Warnings}" Margin="0,8,0,0"><DataGrid Height="90" ItemsSource="{Binding CleanupWarnings}"><DataGrid.Columns><DataGridTextColumn Binding="{Binding Path}" Width="*"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Path}" TextWrapping="NoWrap"/></DataGridTextColumn.Header></DataGridTextColumn><DataGridTextColumn Binding="{Binding Reason}" Width="300"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Reason}" TextWrapping="NoWrap"/></DataGridTextColumn.Header></DataGridTextColumn></DataGrid.Columns></DataGrid></Expander>
    <Expander Grid.Row="7" Header="{DynamicResource Outcome}" Margin="0,8,0,0"><StackPanel><TextBlock Text="{DynamicResource Cleanup.OutcomeBound}" Style="{StaticResource Note}"/><DataGrid Height="140" ItemsSource="{Binding Outcomes}"><DataGrid.Columns><DataGridTextColumn Binding="{Binding Path}" Width="*"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Path}" TextWrapping="NoWrap"/></DataGridTextColumn.Header></DataGridTextColumn><DataGridTextColumn Binding="{Binding Outcome}" Width="150"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Outcome}" TextWrapping="NoWrap"/></DataGridTextColumn.Header></DataGridTextColumn><DataGridTextColumn Binding="{Binding Reason}" Width="220"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Reason}" TextWrapping="NoWrap"/></DataGridTextColumn.Header></DataGridTextColumn></DataGrid.Columns></DataGrid></StackPanel></Expander>
  </Grid>
</UserControl>
