<UserControl x:Class="DiskBurrow.App.Views.CleanupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{DynamicResource Nav.Cleanup}" Style="{StaticResource Title}"/><TextBlock Grid.Row="1" Text="{DynamicResource Cleanup.Warning}" Foreground="#A73436" Margin="0,0,0,12"/>
    <DockPanel Grid.Row="2" Margin="0,0,0,8"><Button Tag="Analyze" Content="{DynamicResource Action.Analyze}" IsEnabled="{Binding Idle}"/><TextBlock Text="{DynamicResource Filter}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Text="{Binding Filter,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Idle}"/></DockPanel>
    <DockPanel Grid.Row="3" Margin="0,0,0,8"><ComboBox ItemsSource="{Binding Cleanup.Categories}" SelectedItem="{Binding Category}" Width="155" IsEnabled="{Binding Idle}"><ComboBox.ItemTemplate><DataTemplate><TextBlock><TextBlock.Text><MultiBinding Converter="{StaticResource LocalValue}"><Binding/><Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></TextBlock.Text></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Tag="ExcludeCategory" Content="{DynamicResource Action.ExcludeCategory}" IsEnabled="{Binding Idle}" Margin="8,0,8,0"/><Button Tag="ExcludeFile" Content="{DynamicResource Action.ExcludeFile}" IsEnabled="{Binding Idle}"/></DockPanel>
    <DataGrid Grid.Row="4" Tag="Candidates" ItemsSource="{Binding CleanupRows}" IsEnabled="{Binding Idle}"><DataGrid.Columns><DataGridTemplateColumn Header="{DynamicResource Select}" Width="60"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="{DynamicResource Path}" Binding="{Binding Path}" Width="*" MinWidth="200"/><DataGridTextColumn Header="{DynamicResource Category}" Binding="{Binding Category}" Width="140"/><DataGridTextColumn Header="{DynamicResource Logical}" Binding="{Binding Bytes,Converter={StaticResource Bytes}}" Width="95"/><DataGridTextColumn Header="{DynamicResource Modified}" Binding="{Binding Modified}" Width="160"/><DataGridTextColumn Header="{DynamicResource Reason}" Binding="{Binding Reason}" Width="210"/></DataGrid.Columns></DataGrid>
    <StackPanel Grid.Row="5"><TextBlock Text="{DynamicResource Cleanup.Bound}" Style="{StaticResource Note}"/><TextBlock Text="{Binding SelectedSummary}" FontWeight="SemiBold"/><Button HorizontalAlignment="Left" Margin="0,10,0,8" Tag="Delete" Content="{DynamicResource Action.Delete}" Foreground="#A73436"><Button.IsEnabled><MultiBinding Converter="{StaticResource AllTrue}"><Binding Path="Idle"/><Binding Path="Cleanup.CanExecuteCleanup"/></MultiBinding></Button.IsEnabled></Button><TextBlock><Run Text="{DynamicResource Cleanup.FreeDelta}"/><Run Text=" : "/><Run Text="{Binding FreeDelta,Mode=OneWay}"/></TextBlock><TextBlock><Run Text="{DynamicResource Cleanup.Unattempted}"/><Run Text=" : "/><Run Text="{Binding Cleanup.UnattemptedCount,Mode=OneWay}"/></TextBlock></StackPanel>
    <Expander Grid.Row="6" Header="{DynamicResource Reason}" Margin="0,8,0,0"><DataGrid Height="90" ItemsSource="{Binding CleanupWarnings}"><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource Path}" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="{DynamicResource Reason}" Binding="{Binding Reason}" Width="300"/></DataGrid.Columns></DataGrid></Expander>
    <Expander Grid.Row="7" Header="{DynamicResource Outcome}" Margin="0,8,0,0"><StackPanel><TextBlock Text="{DynamicResource Cleanup.OutcomeBound}" Style="{StaticResource Note}"/><DataGrid Height="140" ItemsSource="{Binding Outcomes}"><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource Path}" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="{DynamicResource Outcome}" Binding="{Binding Outcome}" Width="150"/><DataGridTextColumn Header="{DynamicResource Reason}" Binding="{Binding Reason}" Width="220"/></DataGrid.Columns></DataGrid></StackPanel></Expander>
  </Grid>
</UserControl>
