<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="DiskBurrow.App.Views.CleanupView">
 <Grid Margin="12">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto" />
   <RowDefinition Height="Auto" />
   <RowDefinition Height="Auto" />
   <RowDefinition Height="Auto" />
   <RowDefinition Height="*" />
   <RowDefinition Height="Auto" />
   <RowDefinition Height="Auto" />
   <RowDefinition Height="Auto" />
  </Grid.RowDefinitions>
  <TextBlock Text="{DynamicResource Nav.Cleanup}" Style="{StaticResource Title}" />
  <StackPanel Grid.Row="1">
   <TextBlock Text="{DynamicResource Cleanup.Warning}" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,8" />
   <Expander Header="{DynamicResource Details}" Margin="0,0,0,4">
    <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock Text="{DynamicResource Cleanup.Scope}" TextWrapping="Wrap" Style="{StaticResource Note}" />
      <TextBlock Text="{DynamicResource Cleanup.Bound}" Style="{StaticResource Note}" Margin="0,3,0,3" />
      <ItemsControl ItemsSource="{Binding CleanupCategorySummaries}" Margin="0,4,0,0">
       <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
         <WrapPanel />
        </ItemsPanelTemplate>
       </ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="6,4" Margin="0,0,6,4" Width="190">
          <StackPanel>
           <TextBlock Text="{Binding Category}" FontWeight="SemiBold" />
           <TextBlock Text="{Binding Size}" />
           <TextBlock Text="{Binding Status}" FontSize="12" />
           <TextBlock Text="{Binding Warnings}" FontSize="12" Foreground="{DynamicResource WarningBrush}" />
          </StackPanel>
         </Border>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
    </ScrollViewer>
   </Expander>
  </StackPanel>
  <DockPanel Grid.Row="2" Margin="0,0,0,8">
   <Button Tag="Analyze" Content="{DynamicResource Action.Analyze}" IsEnabled="{Binding Idle}" />
   <TextBlock Text="{DynamicResource Filter}" VerticalAlignment="Center" Margin="0,0,8,0" />
   <TextBox Text="{Binding Filter,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Idle}" />
  </DockPanel>
  <WrapPanel Grid.Row="3" Margin="0,0,0,8">
   <ComboBox ItemsSource="{Binding Cleanup.Categories}" SelectedItem="{Binding Category}" Width="155" IsEnabled="{Binding Idle}">
    <ComboBox.ItemTemplate>
     <DataTemplate>
      <TextBlock>
       <TextBlock.Text>
        <MultiBinding Converter="{StaticResource LocalValue}">
         <Binding />
         <Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType=Window}" />
        </MultiBinding>
       </TextBlock.Text>
      </TextBlock>
     </DataTemplate>
    </ComboBox.ItemTemplate>
   </ComboBox>
   <Button Tag="ExcludeCategory" Content="{DynamicResource Action.ExcludeCategory}" IsEnabled="{Binding Idle}" Margin="8,0,8,0" />
   <Button Tag="ExcludeFile" Content="{DynamicResource Action.ExcludeFile}" IsEnabled="{Binding Idle}" />
  </WrapPanel>
  <DataGrid Grid.Row="4" Tag="Candidates" ItemsSource="{Binding CleanupRows}" IsEnabled="{Binding Idle}" ToolTip="{DynamicResource Cleanup.Bound}">
   <DataGrid.Columns>
    <DataGridTemplateColumn Width="Auto" MinWidth="52" MaxWidth="64">
     <DataGridTemplateColumn.Header>
      <TextBlock Text="{DynamicResource Select}" TextWrapping="NoWrap" />
     </DataGridTemplateColumn.Header>
     <DataGridTemplateColumn.CellTemplate>
      <DataTemplate>
       <CheckBox IsChecked="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </DataTemplate>
     </DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
    <DataGridTextColumn Binding="{Binding Path}" Width="*" MinWidth="180">
     <DataGridTextColumn.Header>
      <TextBlock Text="{DynamicResource Path}" TextWrapping="NoWrap" />
     </DataGridTextColumn.Header>
     <DataGridTextColumn.ElementStyle>
      <Style TargetType="TextBlock">
       <Setter Property="TextWrapping" Value="NoWrap" />
       <Setter Property="TextTrimming" Value="CharacterEllipsis" />
       <Setter Property="ToolTip" Value="{Binding Path}" />
       <Setter Property="Margin" Value="4,0" />
      </Style>
     </DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
    <DataGridTextColumn Binding="{Binding Category}" Width="Auto" MinWidth="100" MaxWidth="145">
     <DataGridTextColumn.Header>
      <TextBlock Text="{DynamicResource Category}" TextWrapping="NoWrap" />
     </DataGridTextColumn.Header>
     <DataGridTextColumn.ElementStyle>
      <Style TargetType="TextBlock">
       <Setter Property="TextWrapping" Value="NoWrap" />
       <Setter Property="TextTrimming" Value="CharacterEllipsis" />
       <Setter Property="ToolTip" Value="{Binding Category}" />
       <Setter Property="Margin" Value="4,0" />
      </Style>
     </DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
    <DataGridTextColumn Binding="{Binding Bytes,Converter={StaticResource Bytes}}" Width="Auto" MinWidth="78" MaxWidth="100">
     <DataGridTextColumn.Header>
      <TextBlock Text="{DynamicResource Logical}" TextWrapping="NoWrap" />
     </DataGridTextColumn.Header>
     <DataGridTextColumn.ElementStyle>
      <Style TargetType="TextBlock">
       <Setter Property="TextWrapping" Value="NoWrap" />
       <Setter Property="TextTrimming" Value="CharacterEllipsis" />
       <Setter Property="ToolTip" Value="{Binding Bytes,Converter={StaticResource Bytes}}" />
       <Setter Property="Margin" Value="4,0" />
      </Style>
     </DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
    <DataGridTextColumn Binding="{Binding Modified}" Width="Auto" MinWidth="120" MaxWidth="150">
     <DataGridTextColumn.Header>
      <TextBlock Text="{DynamicResource Modified}" TextWrapping="NoWrap" />
     </DataGridTextColumn.Header>
     <DataGridTextColumn.ElementStyle>
      <Style TargetType="TextBlock">
       <Setter Property="TextWrapping" Value="NoWrap" />
       <Setter Property="TextTrimming" Value="CharacterEllipsis" />
       <Setter Property="ToolTip" Value="{Binding Modified}" />
       <Setter Property="Margin" Value="4,0" />
      </Style>
     </DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
    <DataGridTextColumn Binding="{Binding Reason}" Width="Auto" MinWidth="140" MaxWidth="200">
     <DataGridTextColumn.Header>
      <TextBlock Text="{DynamicResource Reason}" TextWrapping="NoWrap" />
     </DataGridTextColumn.Header>
     <DataGridTextColumn.ElementStyle>
      <Style TargetType="TextBlock">
       <Setter Property="TextWrapping" Value="NoWrap" />
       <Setter Property="TextTrimming" Value="CharacterEllipsis" />
       <Setter Property="ToolTip" Value="{Binding Reason}" />
       <Setter Property="Margin" Value="4,0" />
      </Style>
     </DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
   </DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="5">
   <DockPanel Margin="0,4,0,0">
    <Button HorizontalAlignment="Left" Margin="6,0,0,0" Tag="Delete" Content="{DynamicResource Action.Delete}" Foreground="{DynamicResource WarningBrush}" DockPanel.Dock="Right">
     <Button.IsEnabled>
      <MultiBinding Converter="{StaticResource AllTrue}">
       <Binding Path="Idle" />
       <Binding Path="Cleanup.CanExecuteCleanup" />
      </MultiBinding>
     </Button.IsEnabled>
    </Button>
    <StackPanel>
     <TextBlock Text="{Binding SelectedSummary}" FontWeight="SemiBold" />
     <TextBlock>
      <Run Text="{DynamicResource Cleanup.FreeDelta}" />
      <Run Text=" : " />
      <Run Text="{Binding FreeDelta,Mode=OneWay}" />
     </TextBlock>
     <TextBlock>
      <Run Text="{DynamicResource Cleanup.Unattempted}" />
      <Run Text=" : " />
      <Run Text="{Binding Cleanup.UnattemptedCount,Mode=OneWay}" />
     </TextBlock>
    </StackPanel>
   </DockPanel>
  </StackPanel>
  <Expander Grid.Row="6" Header="{DynamicResource Cleanup.Warnings}" Margin="0,4,0,0">
   <DataGrid Height="90" ItemsSource="{Binding CleanupWarnings}">
    <DataGrid.Columns>
     <DataGridTextColumn Binding="{Binding Path}" Width="*">
      <DataGridTextColumn.Header>
       <TextBlock Text="{DynamicResource Path}" TextWrapping="NoWrap" />
      </DataGridTextColumn.Header>
      <DataGridTextColumn.ElementStyle>
       <Style TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="ToolTip" Value="{Binding Path}" />
        <Setter Property="Margin" Value="4,0" />
       </Style>
      </DataGridTextColumn.ElementStyle>
     </DataGridTextColumn>
     <DataGridTextColumn Binding="{Binding Reason}" Width="Auto" MinWidth="160" MaxWidth="240">
      <DataGridTextColumn.Header>
       <TextBlock Text="{DynamicResource Reason}" TextWrapping="NoWrap" />
      </DataGridTextColumn.Header>
      <DataGridTextColumn.ElementStyle>
       <Style TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="ToolTip" Value="{Binding Reason}" />
        <Setter Property="Margin" Value="4,0" />
       </Style>
      </DataGridTextColumn.ElementStyle>
     </DataGridTextColumn>
    </DataGrid.Columns>
   </DataGrid>
  </Expander>
  <Expander Grid.Row="7" Header="{DynamicResource Outcome}" Margin="0,4,0,0">
   <StackPanel>
    <TextBlock Text="{DynamicResource Cleanup.OutcomeBound}" Style="{StaticResource Note}" />
    <DataGrid Height="140" ItemsSource="{Binding Outcomes}">
     <DataGrid.Columns>
      <DataGridTextColumn Binding="{Binding Path}" Width="*">
       <DataGridTextColumn.Header>
        <TextBlock Text="{DynamicResource Path}" TextWrapping="NoWrap" />
       </DataGridTextColumn.Header>
       <DataGridTextColumn.ElementStyle>
        <Style TargetType="TextBlock">
         <Setter Property="TextWrapping" Value="NoWrap" />
         <Setter Property="TextTrimming" Value="CharacterEllipsis" />
         <Setter Property="ToolTip" Value="{Binding Path}" />
         <Setter Property="Margin" Value="4,0" />
        </Style>
       </DataGridTextColumn.ElementStyle>
      </DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding Outcome}" Width="Auto" MinWidth="88" MaxWidth="120">
       <DataGridTextColumn.Header>
        <TextBlock Text="{DynamicResource Outcome}" TextWrapping="NoWrap" />
       </DataGridTextColumn.Header>
       <DataGridTextColumn.ElementStyle>
        <Style TargetType="TextBlock">
         <Setter Property="TextWrapping" Value="NoWrap" />
         <Setter Property="TextTrimming" Value="CharacterEllipsis" />
         <Setter Property="ToolTip" Value="{Binding Outcome}" />
         <Setter Property="Margin" Value="4,0" />
        </Style>
       </DataGridTextColumn.ElementStyle>
      </DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding Reason}" Width="Auto" MinWidth="145" MaxWidth="200">
       <DataGridTextColumn.Header>
        <TextBlock Text="{DynamicResource Reason}" TextWrapping="NoWrap" />
       </DataGridTextColumn.Header>
       <DataGridTextColumn.ElementStyle>
        <Style TargetType="TextBlock">
         <Setter Property="TextWrapping" Value="NoWrap" />
         <Setter Property="TextTrimming" Value="CharacterEllipsis" />
         <Setter Property="ToolTip" Value="{Binding Reason}" />
         <Setter Property="Margin" Value="4,0" />
        </Style>
       </DataGridTextColumn.ElementStyle>
      </DataGridTextColumn>
     </DataGrid.Columns>
    </DataGrid>
   </StackPanel>
  </Expander>
 </Grid>
</UserControl>