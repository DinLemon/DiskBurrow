<UserControl x:Class="DiskBurrow.App.Views.HistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="160"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{DynamicResource Nav.History}" Style="{StaticResource Title}"/><TextBlock Grid.Row="1" Text="{DynamicResource History.Sparse}" Style="{StaticResource Note}"/>
    <DataGrid Grid.Row="2" Tag="History" ItemsSource="{Binding History.Snapshots}" SelectedItem="{Binding History.SelectedSnapshot,Mode=OneWay}"><DataGrid.Columns><DataGridTextColumn Binding="{Binding CompletedUtc}" Width="220"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Scan.Time}" TextWrapping="NoWrap"/></DataGridTextColumn.Header></DataGridTextColumn><DataGridTextColumn Binding="{Binding Root}" Width="*"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Root}" TextWrapping="NoWrap"/></DataGridTextColumn.Header></DataGridTextColumn></DataGrid.Columns></DataGrid><StackPanel Grid.Row="3"><TextBlock Text="{DynamicResource Delta}" Style="{StaticResource Section}"/><TextBlock><Run Text="{Binding History.PreviousUtc,Mode=OneWay}"/><Run Text=" → "/><Run Text="{Binding History.ComparedUtc,Mode=OneWay}"/></TextBlock></StackPanel>
    <DataGrid Grid.Row="4" ItemsSource="{Binding History.Changes}"><DataGrid.Columns><DataGridTextColumn Binding="{Binding Path}" Width="*" MinWidth="220"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Path}" TextWrapping="NoWrap"/></DataGridTextColumn.Header></DataGridTextColumn><DataGridTextColumn Binding="{Binding LogicalDeltaBytes,Converter={StaticResource Bytes}}" Width="110"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Delta}" TextWrapping="NoWrap"/></DataGridTextColumn.Header></DataGridTextColumn><DataGridTemplateColumn Width="170"><DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Kind}" TextWrapping="NoWrap"/></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><TextBlock.Text><MultiBinding Converter="{StaticResource LocalValue}" ConverterParameter="Change."><Binding Path="Kind"/><Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></TextBlock.Text></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
  </Grid>
</UserControl>
