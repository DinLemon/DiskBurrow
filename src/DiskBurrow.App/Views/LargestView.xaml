<UserControl x:Class="DiskBurrow.App.Views.LargestView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{DynamicResource Nav.Largest}" Style="{StaticResource Title}"/><TextBlock Grid.Row="1" Text="{DynamicResource Lists.Bound}" Style="{StaticResource Note}"/>
    <StackPanel Grid.Row="2"><WrapPanel Margin="0,0,0,8"><Button Tag="OpenPath" Content="{DynamicResource Action.Open}"/><Button Tag="Export" Content="{DynamicResource Action.Export}" IsEnabled="{Binding Idle}"/></WrapPanel><TextBlock Text="{Binding AlertMessage}" Style="{StaticResource Note}"/><TextBox Text="{Binding AlertPath,Mode=OneWay}" Style="{StaticResource PathText}" ToolTip="{DynamicResource Alert.Path}"/></StackPanel>
    <DataGrid x:Name="Folders" Grid.Row="3" Tag="Folders" ItemsSource="{Binding LargestFolders}" SelectedItem="{Binding FocusedLargestFolder,Mode=OneWay}"><DataGrid.Columns>
      <DataGridTemplateColumn Width="80"><DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Select}" TextWrapping="NoWrap"/></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.Idle,RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{DynamicResource Manual.SelectionHelp}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Binding="{Binding Path}" Width="*" MinWidth="220"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Path}" TextWrapping="NoWrap"/></DataGridTextColumn.Header></DataGridTextColumn><DataGridTextColumn Binding="{Binding LogicalBytes,Converter={StaticResource Bytes}}" Width="110"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Logical}" TextWrapping="NoWrap"/></DataGridTextColumn.Header></DataGridTextColumn><DataGridTextColumn Binding="{Binding AllocatedBytes,Converter={StaticResource Bytes}}" Width="110"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Allocated}" TextWrapping="NoWrap"/></DataGridTextColumn.Header></DataGridTextColumn><DataGridTemplateColumn Width="100"><DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Coverage}" TextWrapping="NoWrap"/></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><TextBlock.Text><MultiBinding Converter="{StaticResource LocalValue}"><Binding Path="CoverageComplete"/><Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></TextBlock.Text></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
    <TextBlock Grid.Row="4" Text="{DynamicResource Manual.Files}" Style="{StaticResource Section}"/>
    <DataGrid Grid.Row="5" Tag="Files" ItemsSource="{Binding LargestFiles}"><DataGrid.Columns>
      <DataGridTemplateColumn Width="80"><DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Select}" TextWrapping="NoWrap"/></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.Idle,RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{DynamicResource Manual.SelectionHelp}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Binding="{Binding Path}" Width="*" MinWidth="220"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Path}" TextWrapping="NoWrap"/></DataGridTextColumn.Header></DataGridTextColumn><DataGridTextColumn Binding="{Binding LogicalBytes,Converter={StaticResource Bytes}}" Width="110"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Logical}" TextWrapping="NoWrap"/></DataGridTextColumn.Header></DataGridTextColumn><DataGridTextColumn Binding="{Binding AllocatedBytes,Converter={StaticResource Bytes}}" Width="110"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Allocated}" TextWrapping="NoWrap"/></DataGridTextColumn.Header></DataGridTextColumn></DataGrid.Columns></DataGrid>
    <WrapPanel Grid.Row="6" Margin="0,12,0,0" ToolTip="{DynamicResource Manual.SelectionHelp}"><Button Tag="AnalyzeManual" Content="{DynamicResource Manual.Analyze}" IsEnabled="{Binding CanAnalyzeManual}" Margin="0,0,8,8"/><Button Tag="DeleteManual" Content="{DynamicResource Manual.Delete}" IsEnabled="{Binding CanDeleteManual}" Margin="0,0,8,8"/><Button Tag="ReviewManual" Content="{DynamicResource Manual.Review}" IsEnabled="{Binding HasManualReview}" Margin="0,0,8,8"/><TextBlock Text="{Binding ManualSelectedSummary}" VerticalAlignment="Center" Margin="0,0,0,8"/></WrapPanel>
    <TextBlock Grid.Row="7" Text="{Binding ManualStaleMessage}" Style="{StaticResource Note}" Visibility="{Binding Manual.SnapshotStale,Converter={StaticResource BoolVisibility}}"/>
  </Grid>
</UserControl>
