<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="DiskBurrow.App.Views.LargestView">
 <Grid Margin="12">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto" />
   <RowDefinition Height="Auto" />
   <RowDefinition Height="Auto" />
   <RowDefinition Height="*" />
   <RowDefinition Height="Auto" />
   <RowDefinition Height="*" />
   <RowDefinition Height="Auto" />
   <RowDefinition Height="Auto" />
  </Grid.RowDefinitions>
  <TextBlock Text="{DynamicResource Nav.Largest}" Style="{StaticResource Title}" />
  <StackPanel Grid.Row="2" ToolTip="{DynamicResource Lists.Bound}">
   <WrapPanel Margin="0,0,0,8">
    <Button Tag="OpenPath" Content="{DynamicResource Action.Open}" />
    <Button Tag="Export" Content="{DynamicResource Action.Export}" IsEnabled="{Binding Idle}" />
   </WrapPanel>
   <TextBlock Text="{Binding AlertMessage}" Margin="0,2,0,2">
    <TextBlock.Style>
     <Style TargetType="TextBlock" BasedOn="{StaticResource Note}">
      <Style.Triggers>
       <Trigger Property="Text" Value="{x:Null}">
        <Setter Property="Visibility" Value="Collapsed" />
       </Trigger>
       <Trigger Property="Text" Value="">
        <Setter Property="Visibility" Value="Collapsed" />
       </Trigger>
      </Style.Triggers>
     </Style>
    </TextBlock.Style>
   </TextBlock>
   <TextBox Text="{Binding AlertPath,Mode=OneWay}" ToolTip="{DynamicResource Alert.Path}" MaxHeight="30" HorizontalScrollBarVisibility="Hidden">
    <TextBox.Style>
     <Style TargetType="TextBox" BasedOn="{StaticResource PathText}">
      <Style.Triggers>
       <Trigger Property="Text" Value="{x:Null}">
        <Setter Property="Visibility" Value="Collapsed" />
       </Trigger>
       <Trigger Property="Text" Value="">
        <Setter Property="Visibility" Value="Collapsed" />
       </Trigger>
      </Style.Triggers>
     </Style>
    </TextBox.Style>
   </TextBox>
  </StackPanel>
  <DataGrid x:Name="Folders" Grid.Row="3" Tag="Folders" ItemsSource="{Binding LargestFolders}" SelectedItem="{Binding FocusedLargestFolder,Mode=OneWay}">
   <DataGrid.Columns>
    <DataGridTemplateColumn Width="Auto" MinWidth="52" MaxWidth="64">
     <DataGridTemplateColumn.Header>
      <TextBlock Text="{DynamicResource Select}" TextWrapping="NoWrap" />
     </DataGridTemplateColumn.Header>
     <DataGridTemplateColumn.CellTemplate>
      <DataTemplate>
       <CheckBox IsChecked="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.Idle,RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{DynamicResource Manual.SelectionHelp}" />
      </DataTemplate>
     </DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
    <DataGridTextColumn Binding="{Binding Path}" Width="*" MinWidth="180">
     <DataGridTextColumn.Header>
      <TextBlock Text="{DynamicResource Path}" TextWrapping="NoWrap" />
     </DataGridTextColumn.Header>
     <DataGridTextColumn.ElementStyle>
      <Style TargetType="TextBlock">
       <Setter Property="TextWrapping" Value="NoWrap" />
       <Setter Property="TextTrimming" Value="CharacterEllipsis" />
       <Setter Property="ToolTip" Value="{Binding Path}" />
       <Setter Property="Margin" Value="4,0" />
      </Style>
     </DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
    <DataGridTextColumn Binding="{Binding LogicalBytes,Converter={StaticResource Bytes}}" Width="Auto" MinWidth="88" MaxWidth="125">
     <DataGridTextColumn.Header>
      <TextBlock Text="{DynamicResource Logical}" TextWrapping="NoWrap" />
     </DataGridTextColumn.Header>
     <DataGridTextColumn.ElementStyle>
      <Style TargetType="TextBlock">
       <Setter Property="TextWrapping" Value="NoWrap" />
       <Setter Property="TextTrimming" Value="CharacterEllipsis" />
       <Setter Property="ToolTip" Value="{Binding LogicalBytes,Converter={StaticResource Bytes}}" />
       <Setter Property="Margin" Value="4,0" />
      </Style>
     </DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
    <DataGridTextColumn Binding="{Binding AllocatedBytes,Converter={StaticResource Bytes}}" Width="Auto" MinWidth="88" MaxWidth="125">
     <DataGridTextColumn.Header>
      <TextBlock Text="{DynamicResource Allocated}" TextWrapping="NoWrap" />
     </DataGridTextColumn.Header>
     <DataGridTextColumn.ElementStyle>
      <Style TargetType="TextBlock">
       <Setter Property="TextWrapping" Value="NoWrap" />
       <Setter Property="TextTrimming" Value="CharacterEllipsis" />
       <Setter Property="ToolTip" Value="{Binding AllocatedBytes,Converter={StaticResource Bytes}}" />
       <Setter Property="Margin" Value="4,0" />
      </Style>
     </DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
    <DataGridTemplateColumn Width="Auto" MinWidth="80" MaxWidth="110">
     <DataGridTemplateColumn.Header>
      <TextBlock Text="{DynamicResource Coverage}" TextWrapping="NoWrap" />
     </DataGridTemplateColumn.Header>
     <DataGridTemplateColumn.CellTemplate>
      <DataTemplate>
       <TextBlock>
        <TextBlock.Text>
         <MultiBinding Converter="{StaticResource LocalValue}">
          <Binding Path="CoverageComplete" />
          <Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType=Window}" />
         </MultiBinding>
        </TextBlock.Text>
       </TextBlock>
      </DataTemplate>
     </DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
   </DataGrid.Columns>
  </DataGrid>
  <TextBlock Grid.Row="4" Text="{DynamicResource Manual.Files}" Style="{StaticResource Section}" />
  <DataGrid Grid.Row="5" Tag="Files" ItemsSource="{Binding LargestFiles}">
   <DataGrid.Columns>
    <DataGridTemplateColumn Width="Auto" MinWidth="52" MaxWidth="64">
     <DataGridTemplateColumn.Header>
      <TextBlock Text="{DynamicResource Select}" TextWrapping="NoWrap" />
     </DataGridTemplateColumn.Header>
     <DataGridTemplateColumn.CellTemplate>
      <DataTemplate>
       <CheckBox IsChecked="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.Idle,RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{DynamicResource Manual.SelectionHelp}" />
      </DataTemplate>
     </DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
    <DataGridTextColumn Binding="{Binding Path}" Width="*" MinWidth="180">
     <DataGridTextColumn.Header>
      <TextBlock Text="{DynamicResource Path}" TextWrapping="NoWrap" />
     </DataGridTextColumn.Header>
     <DataGridTextColumn.ElementStyle>
      <Style TargetType="TextBlock">
       <Setter Property="TextWrapping" Value="NoWrap" />
       <Setter Property="TextTrimming" Value="CharacterEllipsis" />
       <Setter Property="ToolTip" Value="{Binding Path}" />
       <Setter Property="Margin" Value="4,0" />
      </Style>
     </DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
    <DataGridTextColumn Binding="{Binding LogicalBytes,Converter={StaticResource Bytes}}" Width="Auto" MinWidth="88" MaxWidth="125">
     <DataGridTextColumn.Header>
      <TextBlock Text="{DynamicResource Logical}" TextWrapping="NoWrap" />
     </DataGridTextColumn.Header>
     <DataGridTextColumn.ElementStyle>
      <Style TargetType="TextBlock">
       <Setter Property="TextWrapping" Value="NoWrap" />
       <Setter Property="TextTrimming" Value="CharacterEllipsis" />
       <Setter Property="ToolTip" Value="{Binding LogicalBytes,Converter={StaticResource Bytes}}" />
       <Setter Property="Margin" Value="4,0" />
      </Style>
     </DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
    <DataGridTextColumn Binding="{Binding AllocatedBytes,Converter={StaticResource Bytes}}" Width="Auto" MinWidth="88" MaxWidth="125">
     <DataGridTextColumn.Header>
      <TextBlock Text="{DynamicResource Allocated}" TextWrapping="NoWrap" />
     </DataGridTextColumn.Header>
     <DataGridTextColumn.ElementStyle>
      <Style TargetType="TextBlock">
       <Setter Property="TextWrapping" Value="NoWrap" />
       <Setter Property="TextTrimming" Value="CharacterEllipsis" />
       <Setter Property="ToolTip" Value="{Binding AllocatedBytes,Converter={StaticResource Bytes}}" />
       <Setter Property="Margin" Value="4,0" />
      </Style>
     </DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
   </DataGrid.Columns>
  </DataGrid>
  <WrapPanel Grid.Row="6" Margin="0,6,0,0" ToolTip="{DynamicResource Manual.SelectionHelp}">
   <Button Tag="AnalyzeManual" Content="{DynamicResource Manual.Analyze}" IsEnabled="{Binding CanAnalyzeManual}" Margin="0,0,6,0" />
   <Button Tag="DeleteManual" Content="{DynamicResource Manual.Delete}" IsEnabled="{Binding CanDeleteManual}" Margin="0,0,6,0" />
   <Button Tag="ReviewManual" Content="{DynamicResource Manual.Review}" IsEnabled="{Binding HasManualReview}" Margin="0,0,6,0" />
   <TextBlock Text="{Binding ManualSelectedSummary}" VerticalAlignment="Center" Margin="0,0,6,0" />
  </WrapPanel>
  <TextBlock Grid.Row="7" Text="{Binding ManualStaleMessage}" Style="{StaticResource Note}" Visibility="{Binding Manual.SnapshotStale,Converter={StaticResource BoolVisibility}}" />
 </Grid>
</UserControl>