<UserControl x:Class="DiskBurrow.App.Views.LargestView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{DynamicResource Nav.Largest}" Style="{StaticResource Title}"/><TextBlock Grid.Row="1" Text="{DynamicResource Lists.Bound}" Style="{StaticResource Note}"/>
    <StackPanel Grid.Row="2"><WrapPanel Margin="0,0,0,8"><Button Tag="OpenPath" Content="{DynamicResource Action.Open}"/><Button Tag="Export" Content="{DynamicResource Action.Export}" IsEnabled="{Binding Idle}"/></WrapPanel><TextBlock Text="{Binding AlertMessage}" Style="{StaticResource Note}"/><TextBox Text="{Binding AlertPath,Mode=OneWay}" Style="{StaticResource PathText}" ToolTip="{DynamicResource Alert.Path}"/></StackPanel>
    <DataGrid x:Name="Folders" Grid.Row="3" Tag="Folders" ItemsSource="{Binding Overview.Directories}" SelectedItem="{Binding Overview.FocusedDirectory,Mode=OneWay}"><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource Path}" Binding="{Binding Path}" Width="*" MinWidth="220"/><DataGridTextColumn Header="{DynamicResource Logical}" Binding="{Binding LogicalBytes,Converter={StaticResource Bytes}}" Width="110"/><DataGridTextColumn Header="{DynamicResource Allocated}" Binding="{Binding AllocatedBytes,Converter={StaticResource Bytes}}" Width="110"/><DataGridTemplateColumn Header="{DynamicResource Coverage}" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><TextBlock.Text><MultiBinding Converter="{StaticResource LocalValue}"><Binding Path="CoverageComplete"/><Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></TextBlock.Text></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
    <TextBlock Grid.Row="4" Text="{DynamicResource Path}" Style="{StaticResource Section}"/>
    <DataGrid Grid.Row="5" Tag="Files" ItemsSource="{Binding Overview.Files}"><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource Path}" Binding="{Binding Path}" Width="*" MinWidth="220"/><DataGridTextColumn Header="{DynamicResource Logical}" Binding="{Binding LogicalBytes,Converter={StaticResource Bytes}}" Width="110"/><DataGridTextColumn Header="{DynamicResource Allocated}" Binding="{Binding AllocatedBytes,Converter={StaticResource Bytes}}" Width="110"/></DataGrid.Columns></DataGrid>
  </Grid>
</UserControl>
