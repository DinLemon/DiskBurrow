<UserControl x:Class="DiskBurrow.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24" IsEnabled="{Binding Idle}"><TextBlock Text="{DynamicResource Nav.Settings}" Style="{StaticResource Title}"/><TextBlock Text="{DynamicResource Settings.Explanation}" Style="{StaticResource Note}"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/></Grid.RowDefinitions><TextBlock Text="{DynamicResource Settings.Interval}" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding Settings.Intervals}" SelectedItem="{Binding Settings.IntervalHours}"/><TextBlock Grid.Row="1" Text="{DynamicResource Settings.Low}" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.LowGiB,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/><TextBlock Grid.Row="2" Text="{DynamicResource Settings.Growth}" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.GrowthGiB,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/><TextBlock Grid.Row="3" Text="{DynamicResource Settings.Language}" VerticalAlignment="Center"/><ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Settings.Languages}" SelectedItem="{Binding Language}"/></Grid>
    <CheckBox Content="{DynamicResource Settings.Battery}" IsChecked="{Binding Settings.AllowOnBattery}" Margin="0,16,0,10"/><CheckBox Content="{DynamicResource Settings.Autostart}" IsChecked="{Binding Settings.Autostart}" Margin="0,0,0,10"/>
    <TextBlock Text="{DynamicResource Pause.Explanation}" Style="{StaticResource Note}"/><TextBlock Text="{DynamicResource Settings.Exclusions}" Margin="0,12,0,6"/><TextBox Text="{Binding Settings.Exclusions,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
    <TextBlock Text="{DynamicResource Settings.Temp}" Margin="0,12,0,6"/><TextBox Text="{Binding Settings.CustomTemp,UpdateSourceTrigger=PropertyChanged}" HorizontalScrollBarVisibility="Auto"/>
    <Button Tag="Save" Content="{DynamicResource Action.Save}" HorizontalAlignment="Left" Margin="0,20,0,0"/>
    <StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Tag="Repository" Content="{DynamicResource Link.Repository}"/><Button Tag="Releases" Content="{DynamicResource Link.Releases}"/></StackPanel>
  </StackPanel></ScrollViewer>
</UserControl>
