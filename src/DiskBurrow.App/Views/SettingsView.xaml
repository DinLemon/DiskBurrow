<UserControl x:Class="DiskBurrow.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel Margin="16" IsEnabled="{Binding Idle}">
    <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Button Tag="Save" Content="{DynamicResource Action.Save}"/><Button Tag="Repository" Content="{DynamicResource Link.Repository}"/><Button Tag="Releases" Content="{DynamicResource Link.Releases}"/></WrapPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{DynamicResource Nav.Settings}" Style="{StaticResource Title}"/><TextBlock Text="{DynamicResource Settings.Explanation}" Style="{StaticResource Note}"/>
    <Grid HorizontalAlignment="Left">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Width="220" Margin="0,0,16,16"><TextBlock Text="{DynamicResource Settings.Interval}" Margin="0,0,0,8"/><ComboBox ItemsSource="{Binding Settings.Intervals}" SelectedItem="{Binding Settings.IntervalHours}" Width="200" Height="34" HorizontalAlignment="Left"/></StackPanel>
      <StackPanel Grid.Column="1" Width="220" Margin="0,0,0,16"><TextBlock Text="{DynamicResource Settings.Low}" Margin="0,0,0,8"/><TextBox Text="{Binding Settings.LowGB,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" Width="200" Height="34" HorizontalAlignment="Left"/></StackPanel>
      <StackPanel Grid.Row="1" Width="220" Margin="0,0,16,0"><TextBlock Text="{DynamicResource Settings.Growth}" Margin="0,0,0,8"/><TextBox Text="{Binding Settings.GrowthGB,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" Width="200" Height="34" HorizontalAlignment="Left"/></StackPanel>
      <StackPanel Grid.Row="2" Width="220" Margin="0,12,16,0"><TextBlock Text="{DynamicResource Settings.Theme}" Margin="0,0,0,8"/><ComboBox ItemsSource="{Binding Settings.Themes}" SelectedItem="{Binding Settings.Theme}" Width="200" Height="34" HorizontalAlignment="Left"><ComboBox.ItemTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{DynamicResource Theme.Light}"/><Style.Triggers><DataTrigger Binding="{Binding}" Value="dark"><Setter Property="Text" Value="{DynamicResource Theme.Dark}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="1" Width="220"><TextBlock Text="{DynamicResource Settings.Language}" Margin="0,0,0,8"/><ComboBox ItemsSource="{Binding Settings.Languages}" SelectedItem="{Binding Language}" Width="200" Height="34" HorizontalAlignment="Left"/></StackPanel>
    </Grid>
    <CheckBox Content="{DynamicResource Settings.Battery}" IsChecked="{Binding Settings.AllowOnBattery}" Margin="0,16,0,10"/><CheckBox Content="{DynamicResource Settings.Autostart}" IsChecked="{Binding Settings.Autostart}" Margin="0,0,0,10"/>
    <TextBlock Text="{DynamicResource Pause.Explanation}" Style="{StaticResource Note}"/><TextBlock Text="{DynamicResource Settings.Exclusions}" Margin="0,12,0,6"/><TextBox Text="{Binding Settings.Exclusions,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
    <TextBlock Text="{DynamicResource Settings.Temp}" Margin="0,12,0,6"/><TextBox Text="{Binding Settings.CustomTemp,UpdateSourceTrigger=PropertyChanged}" HorizontalScrollBarVisibility="Auto"/>
  </StackPanel></ScrollViewer>
  </DockPanel>
</UserControl>
