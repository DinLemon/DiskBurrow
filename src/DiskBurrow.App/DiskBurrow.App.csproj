<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><ImplicitUsings>disable</ImplicitUsings><ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>Resources/DiskBurrow.ico</ApplicationIcon></PropertyGroup>
  <PropertyGroup>
    <AssemblyName>DiskBurrow</AssemblyName>
    <RootNamespace>DiskBurrow.App</RootNamespace>
    <RuntimeFrameworkVersion Condition="'$(SelfContained)' == 'true'">10.0.12</RuntimeFrameworkVersion>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../DiskBurrow.Windows/DiskBurrow.Windows.csproj"/><ProjectReference Include="../DiskBurrow.Storage/DiskBurrow.Storage.csproj"/><Resource Include="Resources/DiskBurrow.ico"/></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Resources/Strings.*.xaml" WithCulture="false" LogicalName="DiskBurrow.App.Resources.%(Filename)%(Extension)" /></ItemGroup>
  <Target Name="WritePortablePublishManifest" AfterTargets="Publish" Condition="'$(PortableManifestPath)' != ''">
    <WriteLinesToFile File="$(PortableManifestPath)" Lines="@(ResolvedFileToPublish->'%(RelativePath)')" Overwrite="true" Encoding="UTF-8" />
  </Target>
</Project>
