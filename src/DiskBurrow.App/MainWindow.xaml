<Window x:Class="DiskBurrow.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="clr-namespace:DiskBurrow.App.Views" Title="DiskBurrow" Style="{StaticResource {x:Type Window}}" Language="{Binding Language,Mode=OneWay,ConverterCulture=en-US}" Width="1160" Height="800" MinWidth="880" MinHeight="600" Icon="Resources/DiskBurrow.ico" Button.Click="ActionClick" Selector.SelectionChanged="SelectionChanged">
  <DockPanel Margin="12">
    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="DiskBurrow" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <WrapPanel Grid.Column="1" HorizontalAlignment="Right"><Button Content="{DynamicResource Action.Choose}" Tag="Choose" IsEnabled="{Binding Idle}"/><Button Content="{DynamicResource Action.Scan}" Tag="Scan" IsEnabled="{Binding Idle}" Foreground="{DynamicResource AccentBrush}"/><Button Content="{DynamicResource Action.ScanFast}" Tag="ScanFast" IsEnabled="{Binding CanFastScan}" ToolTip="{DynamicResource FastScan.Hint}" ToolTipService.ShowOnDisabled="True" Foreground="{DynamicResource AccentBrush}"/></WrapPanel>
      <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0"><ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Volumes}" SelectedItem="{Binding SelectedVolume}" IsEnabled="{Binding Idle}" Width="210" Margin="10,0,0,0" ToolTip="{DynamicResource Map.Volumes}"><ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><StackPanel.ToolTip><StackPanel><TextBlock Text="{Binding Root}"/><TextBlock Text="{DynamicResource Map.VolumeFree}"/><TextBlock Text="{Binding FreeBytes,Converter={StaticResource Bytes}}"/><TextBlock Text="{DynamicResource Map.VolumeUsed}"/><TextBlock Text="{Binding UsedBytes,Converter={StaticResource Bytes}}"/><TextBlock Text="{DynamicResource Map.VolumeTotal}"/><TextBlock Text="{Binding TotalBytes,Converter={StaticResource Bytes}}"/></StackPanel></StackPanel.ToolTip><TextBlock Text="{Binding Root}" Margin="0,0,6,0"/><TextBlock Text="{Binding FreeBytes,Converter={StaticResource Bytes}}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="{DynamicResource Root}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBox Text="{Binding Root,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Idle}"/></DockPanel>
    </Grid>
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,8,0,0"><StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Progress}" ToolTip="{Binding Progress}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="12,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/><Button Grid.Column="2" Tag="Cancel" Content="{DynamicResource Action.Cancel}" IsEnabled="{Binding Busy}"/></Grid>
      <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding Busy,Converter={StaticResource BoolVisibility}}"/>
      <TextBlock Text="{Binding StartupMessage}" Foreground="{DynamicResource WarningBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <TextBlock Text="{Binding PrimaryMessage}" Foreground="{DynamicResource ErrorBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <Expander Header="{DynamicResource Details}" Margin="0,4,0,0"><Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding StartupDetails}" Value="{x:Null}"/><Condition Binding="{Binding ErrorDetails}" Value="{x:Null}"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed"/></MultiDataTrigger></Style.Triggers></Style></Expander.Style><ScrollViewer MaxHeight="100"><StackPanel><TextBox Text="{Binding StartupDetails,Mode=OneWay}" Style="{StaticResource PathText}"/><TextBox Text="{Binding ErrorDetails,Mode=OneWay}" Style="{StaticResource PathText}"/></StackPanel></ScrollViewer></Expander>
    </StackPanel></Border>
    <TabControl x:Name="Pages" TabStripPlacement="Left" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}">
      <TabItem Header="{DynamicResource Nav.Overview}"><v:OverviewView/></TabItem>
      <TabItem Header="{DynamicResource Nav.Largest}"><v:LargestView/></TabItem>
      <TabItem Header="{DynamicResource Nav.Map}"><v:DiskMapView/></TabItem>
      <TabItem Header="{DynamicResource Nav.History}"><v:HistoryView/></TabItem>
      <TabItem Header="{DynamicResource Nav.Cleanup}"><v:CleanupView/></TabItem>
      <TabItem Header="{DynamicResource Nav.Settings}"><v:SettingsView/></TabItem>
    </TabControl>
  </DockPanel>
</Window>
